@startuml use_case_registration
left to right direction
skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 18
skinparam ArrowColor #354A5F
skinparam usecase {
  BackgroundColor #BEE4F4
  BorderColor #355A70
}
skinparam actor {
  BackgroundColor #BEE4F4
  BorderColor #354A5F
}
skinparam rectangle {
  BackgroundColor White
  BorderColor #758C9E
}
title Заявки и допуск: представление 1 из 3
actor "SH-01\nОрганизатор / представитель федерации" as Organizer
actor "SH-02\nСудья / секретарь" as Judge
actor "SH-03\nПредставитель клуба / тренер" as Club
actor "SH-04\nСпортсмен / законный представитель" as Athlete
rectangle "SH-07\nОсновная платформа ПроБои" as Platform <<actor>> #E7EFF7
rectangle "Турнирный модуль ПроБои" {
  usecase "UC-01 [FR-01]\nНастроить турнир" as UC01
  usecase "UC-02 [FR-02]\nПодать заявку" as UC02
  usecase "UC-03 [FR-03]\nПросмотреть статус заявки" as UC03
  usecase "UC-04 [FR-04]\nПринять решение о допуске" as UC04
}
Organizer -- UC01
Club -- UC02
Club -- UC03
Athlete -- UC02
Athlete -- UC03
Judge -- UC04
Platform -- UC02
@enduml

@startuml use_case_tournament
left to right direction
skinparam backgroundColor White
