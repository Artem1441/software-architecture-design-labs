  BackgroundColor #BEE4F4
  BorderColor #354A5F
}
skinparam rectangle {
  BackgroundColor White
  BorderColor #758C9E
}
title Турнирная сетка и результаты: представление 2 из 3
actor "SH-01\nОрганизатор / представитель федерации" as Organizer
actor "SH-02\nСудья / секретарь" as Judge
rectangle "Турнирный модуль ПроБои" {
  usecase "UC-05 [FR-05]\nСформировать проект сетки" as UC05
  usecase "UC-06 [FR-06]\nСкорректировать проект сетки" as UC06
  usecase "UC-07 [FR-07]\nОпубликовать утверждённую сетку" as UC07
  usecase "UC-08 [FR-08]\nПодтвердить результат поединка" as UC08
  usecase "UC-09 [FR-09]\nИсправить подтверждённый результат" as UC09
  usecase "UC-14 [FR-05 / FR-06 / FR-07]\nПроверить ограничения сетки" as UC14
  usecase "UC-15 [FR-08 / FR-09]\nСогласовать поединки и турнирную таблицу" as UC15
