        <mxCell id="C05" value="&lt;div style=&quot;text-align:center;&quot;&gt;&lt;div style=&quot;font-size:32px;line-height:1.16;font-weight:bold;&quot;&gt;C05 – Турнирная БД&lt;/div&gt;&lt;div style=&quot;height:10px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:26px;line-height:1.16;&quot;&gt;[Container: Database]&lt;br&gt;PostgreSQL&lt;/div&gt;&lt;div style=&quot;height:10px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:28px;line-height:1.16;&quot;&gt;Заявки, сетки, задания, снимки,&lt;br&gt;версии, аудит и outbox&lt;/div&gt;&lt;/div&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=26;rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=16;fontFamily=DejaVu Sans;fontSize=28;fillColor=#218CAE;strokeColor=#218CAE;fontColor=#FFFFFF;" vertex="1" parent="1">
